# Tello Web Controller - Environment Configuration
# Copy this file to .env and adjust values as needed

# Drone connection
TELLO_HOST=192.168.10.1
TELLO_USE_MOCK_DRONE=true

# Backend server
TELLO_API_PORT=8000

# MCP server (local stdio process calling the backend API)
TELLO_MCP_API_URL=http://127.0.0.1:8000
TELLO_MCP_REQUEST_TIMEOUT=10.0

# Frontend
TELLO_FRONTEND_PORT=3000

# Telemetry
TELLO_TELEMETRY_POLL_HZ=4.0

# Flight history database
TELLO_FLIGHT_LOG_DB_PATH=data/flight_logs.sqlite3
TELLO_FLIGHT_VIDEO_MAX_BYTES=524288000
TELLO_AUTO_RECORD_ON_TAKEOFF=false
TELLO_AUTO_RECORD_LANDING_SPEED_THRESHOLD_CM_S=0
TELLO_AUTO_RECORD_LANDING_CONFIRMATION_SAMPLES=8

# Video streaming
TELLO_VIDEO_FPS=30
TELLO_VIDEO_JPEG_QUALITY=70
# Optional ICE candidate hostname/IP override (localhost real-drone sessions
# otherwise advertise the local interface routed to TELLO_HOST)
# TELLO_WEBRTC_PUBLIC_HOST=192.168.1.50
# Optional JSON array shared with browser/server for STUN or TURN traversal
# TELLO_WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.example.org:3478"}]
# Use short-lived credentials if configuring a TURN server.

# CORS (JSON array of allowed origins)
TELLO_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
